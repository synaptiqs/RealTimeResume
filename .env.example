# Copy to .env and adjust.

# Dev uses SQLite. For production, point this at managed Postgres and change
# the datasource provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-in-production-use-a-long-random-string"

# NOTE: This version ships with NO AI integration. No API keys are required.
