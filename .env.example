# Copy to .env and adjust.

# Dev uses SQLite. For production, point this at managed Postgres and change
# the datasource provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-in-production-use-a-long-random-string"

# AI features. The narrow resume-structuring assistant and the paywalled full
# AI assistance both use the Anthropic API. Optional — if unset, AI endpoints
# return a friendly "AI not available" message and the rest of the app works.
#   Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""
